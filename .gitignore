# Systémové soubory
.DS_Store              # macOS
Thumbs.db              # Windows thumbnails
Desktop.ini            # Windows folder settings
*~                     # Linux backup files

# Editor a IDE
.vscode/               # VS Code workspace settings
.vs/                   # Visual Studio
*.swp                  # Vim swap files
*.swo
.idea/                 # JetBrains IDEs
.claude/               # Claude Code lokální nastavení

# Dočasné a pracovní soubory
draft-*                # Rozepsané drafty
temp-*                 # Dočasné soubory
TODO.md                # Lokální TODO seznam
*.tmp
*.bak
*.old

# Lokální poznámky (nepublikované)
private/               # Složka pro soukromé poznámky
local-*.md             # Lokální poznámky
scratch.md             # Poznámkový blok

# Jekyll
_site/                 # Jekyll build output (vygenerované HTML stránky)
.jekyll-cache/         # Jekyll cache
.sass-cache/           # Sass cache
Gemfile.lock           # Ruby dependencies lock file (generuje se automaticky)
.bundle/               # Bundler konfigurace
vendor/                # Vendor dependencies (při použití bundle install --path vendor)
